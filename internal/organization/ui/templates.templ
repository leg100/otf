package ui

import (
	"github.com/leg100/otf/internal"
	"github.com/leg100/otf/internal/organization"
	"github.com/leg100/otf/internal/resource"
	"github.com/leg100/otf/internal/runner"
	"github.com/leg100/otf/internal/ui/helpers"
	"github.com/leg100/otf/internal/path"
	"github.com/leg100/otf/internal/workspace/execution"
	"time"
)

templ organizationNew() {
	<form class="flex flex-col gap-2" action={ path.Create(resource.OrganizationKind, nil) } method="POST">
		<div class="field">
			<label for="name">Name</label>
			<input class="input w-80" type="text" name="name" id="name" required/>
		</div>
		<div>
			<button class="btn" id="create-organization-button">Create organization</button>
		</div>
	</form>
}

type organizationListProps struct {
	*resource.Page[*organization.Organization]
	CanCreate bool
}

templ organizationList(props organizationListProps) {
	@helpers.Table(&organizationTable{}, props.Page)
}

type organizationTable struct{}

templ (t organizationTable) Header() {
	<th>Name</th>
	<th>ID</th>
}

templ (t organizationTable) Row(org *organization.Organization) {
	<tr id={ "org-item-" + org.Name.String() }>
		<td>
			<a class="link" href={ path.Get(org.Name) }>
				{ org.Name.String() }
			</a>
		</td>
		<td>
			@helpers.Identifier(org.ID)
		</td>
	</tr>
}

templ organizationListActions(canCreate bool) {
	<form action={ path.New(resource.OrganizationKind, nil) } method="GET">
		<button
			class="btn"
			id="new-organization-button"
			disabled?={ !canCreate }
			if canCreate {
				title="create a new organization"
			} else {
				title="organization creation has been restricted to site admins"
			}
		>
			New Organization
		</button>
	</form>
}

type organizationEditProps struct {
	org *organization.Organization
	// pools eligible to be the organization's default agent pool
	pools []*runner.Pool
	// whether the subject may set the organization's default execution mode.
	canSetDefaultMode bool
}

templ organizationEdit(props organizationEditProps) {
	<form class="flex flex-col gap-5" action={ path.Update(props.org.Name) } method="POST">
		<div class="field">
			<label for="name">Name</label>
			<input class="input w-80" type="text" name="new_name" id="name" value={ props.org.Name.String() } required/>
		</div>
		if props.canSetDefaultMode {
			<fieldset class="border border-base-content/60 p-3 flex flex-col gap-2">
				<legend>Default execution mode</legend>
				<span class="description">
					The execution mode that new workspaces in this organization are created with. Existing workspaces are unaffected, and a workspace can always override the default with its own execution mode.
				</span>
				<div class="form-checkbox">
					<input type="radio" name="execution_kind" id="remote" value={ execution.RemoteKind } checked?={ props.org.DefaultMode.Kind() == execution.RemoteKind }/>
					<label for="remote">Remote</label>
					<span class="description">Plans and applies occur on the OTF servers.</span>
				</div>
				<div class="form-checkbox">
					<input type="radio" name="execution_kind" id="local" value={ execution.LocalKind } checked?={ props.org.DefaultMode.Kind() == execution.LocalKind }/>
					<label for="local">Local</label>
					<span class="description">
						Plans and applies occur on your local machines. OTF is only used to store and synchronize state.
					</span>
				</div>
				<div class="form-checkbox">
					<input
						class="peer"
						type="radio"
						name="execution_kind"
						id="agent"
						value={ execution.AgentKind }
						checked?={ props.org.DefaultMode.Kind() == execution.AgentKind }
						disabled?={ len(props.pools) == 0 && props.org.DefaultMode.Kind() != execution.AgentKind }
						if len(props.pools) == 0 {
							title="this organization has no agent pool that grants access to all of its workspaces"
						}
					/>
					<label for="agent">Agent</label>
					<span class="description">Plans and applies occur on OTF agents.</span>
					if len(props.pools) > 0 {
						<div class="col-start-2 hidden peer-checked:flex flex-col mt-2 bg-base-300 p-2 gap-2">
							<div class="flex items-center gap-2">
								<label class="text-md" for="agent-pool-id">Default agent pool</label>
								<select class="select" id="agent-pool-id" name="agent_pool_id">
									for _, pool := range props.pools {
										<option
											value={ pool.ID.String() }
											selected?={ props.org.DefaultMode.AgentPoolID() != nil && *props.org.DefaultMode.AgentPoolID() == pool.ID }
										>
											{ pool.Name }
										</option>
									}
								</select>
							</div>
							<span class="description">
								Only pools that grant access to all workspaces in the organization are listed.
							</span>
						</div>
					}
				</div>
			</fieldset>
		}
		<div class="field">
			<button class="btn w-72" id="update-organization-button">Update organization</button>
		</div>
	</form>
}

templ editAdvanced(org *organization.Organization) {
	Delete the organization. Warning: this action is irreversible.
	<form action={ path.Delete(org.Name) } method="POST">
		<button id="delete-organization-button" class="btn btn-error btn-outline" onclick="return confirm('Are you sure you want to delete?')">
			Delete organization
		</button>
		<input type="hidden" name="id" value={ org.ID.String() }/>
	</form>
}

templ getToken(org organization.Name, token *organization.OrganizationToken) {
	<span class="text-base-content/60 text-sm">
		The organization API token is used to manage teams, team membership and workspaces. This token does not have permission to perform plans and applies in workspaces.
	</span>
	if token != nil {
		@helpers.UnpaginatedTable(
			&organizationTokenTable{},
			[]*organization.OrganizationToken{token},
		)
	} else {
		<form class="mt-2" action={ path.CreateOrganizationToken(org) } method="POST">
			<button class="btn w-72">Create organization token</button>
		</form>
	}
}

type organizationTokenTable struct{}

templ (t organizationTokenTable) Header() {
	<th>ID</th>
	<th>Created</th>
	<th>Actions</th>
}

templ (t organizationTokenTable) Row(token *organization.OrganizationToken) {
	<tr id="item-token">
		<td>
			@helpers.Identifier(token.ID)
		</td>
		<td>
			<span>{ internal.Ago(time.Now(), token.CreatedAt) }</span>
		</td>
		<td>
			<div class="flex gap-2">
				<form action={ path.CreateOrganizationToken(token.Organization) } method="POST">
					<button class="btn">Regenerate</button>
				</form>
				<form action={ path.DeleteOrganizationToken(token.Organization) } method="POST">
					@helpers.DeleteButton()
				</form>
			</div>
		</td>
	</tr>
}
